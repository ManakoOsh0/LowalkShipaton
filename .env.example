# Lowalk uses free native geocoding (expo-location) for venue search.
# No Google Places API key is required.

# Optional: enable background-location diagnostics in preview builds
# EXPO_PUBLIC_PRESENCE_DEBUG=1

# RevenueCat public SDK keys — never commit secret keys (sk_...)
#
# Dashboard setup (Test Store for Shipaton / dev):
# 1. Apps & providers → Test Store → copy API key (test_...)
# 2. Products: lowalk_monthly, lowalk_yearly, lowalk_lifetime
# 3. Entitlement: Lowalk Pro (attach products)
# 4. Offering: default 2 ("Default 2") with monthly, yearly, lifetime packages
# 5. Paywall: hosted V2 paywall bound to default 2
# EXPO_PUBLIC_REVENUECAT_PAYWALL_OFFERING_ID=default 2
#
# Dev / Shipaton (public SDK key — safe in the client; never commit sk_ secret keys).
# Copy this file to .env; judges can run Lowalk Pro via RevenueCat Test Store as-is.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_FJQuLKkrYnuotGbcmIpadlvUUPe
#
# Production (when store accounts are ready):
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_sdk_key
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_public_sdk_key
