# Lowalk uses free native geocoding (expo-location) for venue search.
# No Google Places API key is required.

# Optional: enable background-location diagnostics in preview builds
# EXPO_PUBLIC_PRESENCE_DEBUG=1

# RevenueCat public SDK keys (add when integrating purchases — never commit real keys)
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_public_sdk_key
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_public_sdk_key
