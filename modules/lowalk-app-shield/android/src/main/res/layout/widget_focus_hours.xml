<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal 2×2 hours tile — keep in sync with lib/widgetLayoutSpec.ts (WIDGET_HOURS_SPEC). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/focus_hours_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipToOutline="true"
  android:padding="12dp">

  <LinearLayout
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
      android:id="@+id/focus_hours_hourglass"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_marginBottom="4dp"
      android:contentDescription="@string/focus_hours_widget_hourglass"
      android:scaleType="fitCenter"
      android:src="@drawable/widget_hourglass" />

    <TextView
      android:id="@+id/focus_hours_value"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:autoSizeMaxTextSize="28sp"
      android:autoSizeMinTextSize="8sp"
      android:autoSizeStepGranularity="1sp"
      android:autoSizeTextType="uniform"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="0h"
      android:textColor="#1C1C1E"
      android:textSize="28sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/focus_hours_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:autoSizeMaxTextSize="11sp"
      android:autoSizeMinTextSize="8sp"
      android:autoSizeStepGranularity="1sp"
      android:autoSizeTextType="uniform"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="time saved"
      android:textColor="#636366"
      android:textSize="11sp" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/widget_lock_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
      android:id="@+id/widget_lock_scrim"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/widget_lock_scrim" />

    <TextView
      android:id="@+id/widget_pro_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@drawable/widget_pro_badge"
      android:includeFontPadding="false"
      android:paddingHorizontal="14dp"
      android:paddingVertical="6dp"
      android:text="PRO"
      android:textColor="#141210"
      android:textSize="13sp"
      android:textStyle="bold" />
  </FrameLayout>
</FrameLayout>
