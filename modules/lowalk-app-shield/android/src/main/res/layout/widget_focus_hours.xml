<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal 2×2 hours tile — keep in sync with lib/widgetLayoutSpec.ts (WIDGET_HOURS_SPEC). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/focus_hours_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#DEDEDE"
  android:clipToOutline="true"
  android:padding="0dp">

  <LinearLayout
    android:id="@+id/widget_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
      android:id="@+id/focus_hours_hourglass"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginBottom="6dp"
      android:contentDescription="@string/focus_hours_widget_hourglass"
      android:scaleType="fitCenter"
      android:src="@drawable/widget_hourglass" />

    <TextView
      android:id="@+id/focus_hours_value"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="0h"
      android:textColor="#1C1C1E"
      android:textSize="32sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/focus_hours_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="time saved"
      android:textColor="#636366"
      android:textSize="13sp" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/widget_lock_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_lock_scrim"
    android:clipToOutline="true"
    android:visibility="gone">

    <TextView
      android:id="@+id/widget_pro_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@drawable/widget_pro_badge"
      android:includeFontPadding="false"
      android:paddingLeft="14dp"
      android:paddingRight="14dp"
      android:paddingTop="6dp"
      android:paddingBottom="6dp"
      android:text="PRO"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:textStyle="bold" />
  </FrameLayout>
</FrameLayout>
