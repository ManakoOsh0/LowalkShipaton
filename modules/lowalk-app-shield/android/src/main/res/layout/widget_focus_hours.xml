<?xml version="1.0" encoding="utf-8"?>
<!-- Small 2×2 focus-hours widget — big number, short label, hourglass along the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/focus_hours_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_focus_hours_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingHorizontal="10dp"
    android:paddingBottom="4dp">

    <TextView
      android:id="@+id/focus_hours_value"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="@font/space_mono_bold"
      android:gravity="center_horizontal"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="0"
      android:textColor="@color/widget_focus_hours_ink"
      android:textSize="32sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/focus_hours_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:gravity="center_horizontal"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="hours saved"
      android:textColor="@color/widget_focus_hours_ink_muted"
      android:textSize="11sp" />

    <View
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <ImageView
      android:id="@+id/focus_hours_hourglass"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:layout_gravity="center_horizontal"
      android:contentDescription="@string/focus_hours_widget_hourglass"
      android:scaleType="fitCenter"
      android:src="@drawable/widget_hourglass" />
  </LinearLayout>
</FrameLayout>
